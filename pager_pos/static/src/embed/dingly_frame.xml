<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pager_pos.DinglyFrame" owl="1">
        <div class="pager-embed">
            <div class="pager-embed-bar">
                <svg class="pager-mark" viewBox="0 0 64 64" aria-hidden="true"><path d="M32 4a26 26 0 1 1-12.1 49L8.6 59.5a1.6 1.6 0 0 1-2.3-1.9l3.4-11.4A26 26 0 0 1 32 4z" fill="#d9480f"/><g fill="#f5efe6"><rect x="28.6" y="19" width="6.8" height="2.6" rx="1.3"/><rect x="30.9" y="20.4" width="2.2" height="5"/><path d="M20.5 37a11.5 11.5 0 0 1 23 0z"/><rect x="17.5" y="38.4" width="29" height="4.2" rx="2.1"/></g></svg>
                <strong class="pager-embed-name">Dingly</strong>
                <span class="pager-embed-host" t-esc="host"/>
                <span class="pager-embed-spacer"/>
                <button type="button" class="pager-embed-btn" t-on-click="reload"><i class="fa fa-refresh"/> Reload</button>
                <button type="button" class="pager-embed-btn" t-on-click="openTab"><i class="fa fa-external-link"/> Open in new tab</button>
                <button t-if="props.onClose" type="button" class="pager-embed-btn pager-embed-close" t-on-click="props.onClose" aria-label="Close Dingly"><i class="fa fa-times"/> Close</button>
            </div>
            <iframe t-key="state.nonce" class="pager-embed-frame" t-att-src="url" title="Dingly" allow="clipboard-write"/>
        </div>
    </t>
</templates>
