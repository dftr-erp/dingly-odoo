<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//ReceiptHeader" position="before">
            <div class="pager-tracking" t-if="pagerTrackingNumber">
                <div class="pager-tracking-label">Your order number</div>
                <div class="pager-tracking-value" t-esc="pagerTrackingNumber"/>
                <p class="pager-tracking-hint">Scan the tag at the counter and type <t t-esc="pagerTrackingNumber"/>.</p>
            </div>
        </xpath>
    </t>
</templates>
