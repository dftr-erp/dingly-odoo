<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('pos-receipt-contact')]" position="before">
            <div class="pager-tracking" t-if="receipt.pager_number">
                <div class="pager-tracking-label">Your order number</div>
                <div class="pager-tracking-value" t-esc="receipt.pager_number"/>
                <p class="pager-tracking-hint">Scan the tag at the counter and type <t t-esc="receipt.pager_number"/>.</p>
            </div>
        </xpath>
    </t>
</templates>
